# Copy this file to ".env" and fill in real values. The .env file is gitignored
# (never commit real secrets). Used by docker-compose.prod.yml.

# --- PostgreSQL ---
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- job-service ---
# Seed demo rows on first boot. Set to false in production once real data exists.
APP_SEED_SAMPLE_DATA=false

# --- Public domain (Caddy uses this to obtain an automatic HTTPS certificate) ---
# Must be a real domain pointing at the server's IP for HTTPS to work.
DOMAIN=jobtracker.example.com
